# ============================================================
#  Agenda multiusuário no Telegram
#  Copie para ".env" e preencha.
# ============================================================

# --- Telegram ------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAExemploDeTokenDoBotFather
# IDs com acesso a comandos de administrador (opcional)
ADMIN_TELEGRAM_IDS=

# --- Geral ---------------------------------------------------
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
DATABASE_PATH=data/agenda.db
DEFAULT_EVENT_DURATION_MIN=60
DEFAULT_EVENT_TIME=09:00
REMINDER_LEAD_MINUTES=30
REMINDER_CHECK_INTERVAL_SECONDS=90
ALL_DAY_REMINDER_TIME=08:00
AUTOCLEAN_MINUTES=30
AUTOCLEAN_ENABLED=true

# --- OAuth Web do Google (por usuário) -----------------------
# URL pública do bot (no Render é definida automaticamente).
APP_BASE_URL=https://agenda-telegram-bot.onrender.com
OAUTH_REDIRECT_PATH=/oauth/callback
# Do cliente OAuth do tipo "Aplicação Web"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Banco de dados (repositório privado no GitHub) ----------
GITHUB_DATA_REPO=thiagofreitxs/agenda-data
GITHUB_DATA_TOKEN=
GITHUB_DATA_PATH=users.json
GITHUB_DATA_BRANCH=main
# Chave para criptografar os tokens guardados no repositório.
APP_ENCRYPTION_KEY=troque-por-uma-frase-secreta-bem-longa
