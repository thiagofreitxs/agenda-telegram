# ============================================================
#  Configuração da Agenda no Telegram
#  Copie este arquivo para ".env" e preencha os valores.
# ============================================================

# --- Telegram -------------------------------------------------
# Token gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExemploDeTokenDoBotFather

# IDs do Telegram autorizados a usar o bot (só você).
# Descubra o seu enviando /id para o bot (ou use o @userinfobot).
# Pode colocar mais de um, separado por vírgula ou espaço.
ALLOWED_TELEGRAM_IDS=123456789

# --- Fuso horário --------------------------------------------
TIMEZONE=America/Sao_Paulo

# --- Google Calendar -----------------------------------------
# Calendário alvo: "primary" = seu calendário principal.
GOOGLE_CALENDAR_ID=primary

# Forma 1 (recomendada): OAuth, funciona no seu calendário principal.
# Rode localmente "python authorize_google.py" para gerar o token.
# Opção A: arquivo token.json
GOOGLE_TOKEN_FILE=token.json
# Opção B: conteúdo do token em uma linha (melhor para nuvem)
# GOOGLE_TOKEN_JSON={"token":"...","refresh_token":"...","client_id":"...","client_secret":"...","token_uri":"https://oauth2.googleapis.com/token"}
# Arquivo client_secret.json baixado do Google Cloud (usado só para gerar o token)
GOOGLE_CLIENT_SECRET_FILE=client_secret.json

# Forma 2 (alternativa): Conta de serviço (service account).
# Compartilhe seu calendário com o e-mail da service account e
# dê permissão "Fazer alterações nos eventos".
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# --- Comportamento -------------------------------------------
# Duração padrão de um evento quando você não informa o fim (minutos)
DEFAULT_EVENT_DURATION_MIN=60
# Horário padrão quando você informa só a data (ex.: "amanhã")
DEFAULT_EVENT_TIME=09:00
# Quantos minutos antes o bot avisa
REMINDER_LEAD_MINUTES=30
# De quanto em quanto tempo o bot verifica a agenda (segundos)
REMINDER_CHECK_INTERVAL_SECONDS=60
# Horário do lembrete para eventos de "dia inteiro"
ALL_DAY_REMINDER_TIME=08:00
# Limpeza automática da conversa: de quantos em quantos minutos apagar as
# mensagens do chat, e se está ligada por padrão (true/false).
AUTOCLEAN_MINUTES=30
AUTOCLEAN_ENABLED=true
# Banco de dados (SQLite) que guarda o que já foi avisado
DATABASE_PATH=data/agenda.db
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
